# ==========================================
# AI-Based Network Connection Predictor
# Comprehensive .gitignore for GitHub & Vercel
# ==========================================

# Python Environments & Bytecode
venv/
.venv/
env/
ENV/
__pycache__/
*.py[cod]
*$py.class
*.so
.Python

# Pytest & Coverage
.pytest_cache/
.coverage
htmlcov/
.tox/

# Local SQLite Databases & Logs
*.db
*.sqlite
*.sqlite3
*.log

# Node.js & Next.js
node_modules/
**/node_modules/
.next/
**/.next/
out/
build/
dist/
.vercel
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Environment Variables & Secrets (Keep .env.example tracked)
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
backend/.env
frontend/.env
frontend/.env.local

# IDE & Editor Configurations
.vscode/
.idea/
*.swp
*.swo
*.sublime-project
*.sublime-workspace

# Operating System Files
.DS_Store
Thumbs.db
desktop.ini
