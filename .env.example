# AI-Based Network Connection Predictor Environment Configuration

# Application
APP_ENV=development
DEBUG=True
HOST=0.0.0.0
PORT=8000

# Database
# Default uses SQLite for immediate zero-setup execution.
# For production PostgreSQL: postgresql+psycopg2://postgres:postgres@localhost:5432/network_predictor
DATABASE_URL=sqlite:///./network_predictor.db

# Telemetry Collector
COLLECTOR_INTERVAL_SECONDS=5
DEFAULT_PING_TARGET=8.8.8.8
SECONDARY_PING_TARGET=1.1.1.1
PING_COUNT=5
PING_TIMEOUT_SECONDS=2.0

# Degradation & Alert Thresholds
LATENCY_DEGRADATION_THRESHOLD_MS=120.0
PACKET_LOSS_DEGRADATION_THRESHOLD=5.0
JITTER_DEGRADATION_THRESHOLD_MS=25.0
STABILITY_ALERT_THRESHOLD=60.0

# CORS
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
