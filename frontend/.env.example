# Frontend Environment Variables for Local & Vercel Deployments

# For local development:
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_WS_URL=ws://localhost:8000/ws/telemetry

# For production on Vercel:
# Replace with your deployed backend URL (e.g. Render, Railway, Fly.io, or EC2):
# NEXT_PUBLIC_API_URL=https://your-backend-api.onrender.com/api/v1
# NEXT_PUBLIC_WS_URL=wss://your-backend-api.onrender.com/ws/telemetry
